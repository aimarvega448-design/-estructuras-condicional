Algoritmo Felicitaciones
	Definir notaDifinitiva Como Real
	Escribir "Ingrese la nota difinitiva"
	Leer notaDifinitiva
	Escribir "su nota dfinitva es ", notaDifinitiva
	Si notaDifinitiva >= 4.0 Entonces
		Imprimir "Felicitaciones"
	SiNo
		Imprimir "el profe no te quiere"
	Fin Si
FinAlgoritmo
